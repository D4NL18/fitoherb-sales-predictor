# Exemplo de configuração de variáveis de ambiente (substitua com suas credenciais reais no .env)
DB_HOST=fitoherb.ddns.net
DB_PORT=6060
DB_NAME=FITOHERB
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_SCHEMA=Externo01
DB_DRIVER=ODBC Driver 17 for SQL Server

# Autenticação em Produção (Login Nativo pelo Navegador - HTTP Basic Auth)
ENVIRONMENT=development
AUTH_REQUIRED=false
AUTH_USERNAME=seu_usuario
AUTH_PASSWORD=sua_senha
