# Exemplo de configuração de variáveis de ambiente (substitua com suas credenciais reais no .env)
DB_HOST=fitoherb.ddns.net
DB_PORT=6060
DB_NAME=FITOHERB
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_SCHEMA=Externo01
DB_DRIVER=ODBC Driver 17 for SQL Server

# Autenticação em Produção (Login Nativo pelo Navegador - HTTP Basic Auth)
ENVIRONMENT=development
AUTH_REQUIRED=false
AUTH_USERNAME=seu_usuario
AUTH_PASSWORD=sua_senha

# F7 - Diagnostico de tendencia com IA (Vertex AI via ADC; sem chave de API)
TREND_AI_ENABLED=true
TREND_AI_MODEL_DEFAULT=gemini-4-hydrogen
TREND_AI_MODEL_FALLBACK=gemini-3.8-flash
TREND_AI_MONTHLY_BUDGET_USD=1.80
TREND_AI_DAILY_BUDGET_USD=0.20
TREND_AI_LOCATION=global
TREND_AI_PRICING_JSON={"search_per_query":0.014,"models":{"gemini-4-hydrogen":[{"from":"2026-01-01","input_per_million":1.5,"output_per_million":7.5}],"gemini-3.8-flash":[{"from":"2026-01-01","input_per_million":0.75,"output_per_million":3.75},{"from":"2027-01-01","input_per_million":1.5,"output_per_million":7.5}]}}
TREND_INSIGHTS_BUCKET=
GOOGLE_CLOUD_PROJECT=
